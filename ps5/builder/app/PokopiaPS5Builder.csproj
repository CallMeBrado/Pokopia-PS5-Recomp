<Project Sdk="Microsoft.NET.Sdk">
  <!-- The builder's window. .NET Framework 4.8 ships with Windows 10 and 11, so the app needs no runtime install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PokopiaPS5Builder</AssemblyName>
    <RootNamespace>PokopiaPS5Builder</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.2</Version>
    <Product>Pokopia PS5 Builder</Product>
    <Copyright>GPL-3.0-or-later</Copyright>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
</Project>
